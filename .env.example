# Optional host port override for the Go API when running outside Docker.
NETWORKFORGE_ADDR=:8080
# Set to http://api:8080 inside Docker Compose.
NETWORKFORGE_API_URL=http://localhost:8080
# For local Postgres outside Compose, set DATABASE_URL accordingly.
DATABASE_URL=postgres://networkforge:networkforge_local@localhost:5432/networkforge?sslmode=disable
